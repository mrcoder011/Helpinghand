<%- include("./layouts/boilerplate", { body: `

<section class="plans-section">

<div class="container">

<div class="heading">
<h2>Choose Your Job Access Plan</h2>
<p>Join our WhatsApp groups to receive verified placement opportunities.</p>
</div>

<div class="cards">

<!-- BASIC PLAN -->
<div class="card basic">

<div class="badge">Basic Access</div>

<div class="card-title">
Basic Subscription
</div>

<div class="price">₹49</div>

<ul class="features">

<li>✔ Access to verified placement opportunities</li>
<li>✔ Entry level roles suitable for freshers</li>
<li>✔ Regular job alerts and hiring updates</li>
<li>✔ Opportunities shared directly in WhatsApp group</li>
<li>✔ Platform guidance for applying to companies</li>

</ul>

<p class="assure">
We provide a platform where verified placement opportunities are shared. 
Candidates who perform well in all interview rounds have a high chance of selection.
</p>

<a href="/contact"
class="join-btn">
Join Basic WhatsApp Group
</a>

</div>


<!-- PRIME PLAN -->
<div class="card prime">

<div class="badge">Premium Access</div>

<div class="card-title">
Prime Subscription
</div>

<div class="price">₹99</div>

<ul class="features">

<li>✔ Access to premium placement opportunities</li>
<li>✔ Product based company hiring alerts</li>
<li>✔ High quality job opportunity updates</li>
<li>✔ Early access to selected hiring drives</li>
<li>✔ Direct updates through premium WhatsApp group</li>

</ul>

<p class="assure">
This plan provides access to premium placement opportunities and priority hiring updates. 
Candidates who clear all interview rounds have a strong chance of selection.
</p>

<a href="/contact"
class="join-btn">
Join Prime WhatsApp Group
</a>

</div>

</div>

</div>

</section>



<style>

*{
box-sizing:border-box;
}

.plans-section{
background:#f4f6f9;
padding:60px 15px;
}

.container{
max-width:900px;
margin:auto;
}

.heading{
text-align:center;
margin-bottom:40px;
}

.heading h2{
font-size:28px;
font-weight:700;
margin-bottom:8px;
}

.heading p{
color:#666;
font-size:15px;
}


.cards{
display:flex;
gap:20px;
flex-wrap:wrap;
justify-content:center;
}


.card{
background:#fff;
flex:1 1 350px;
max-width:400px;
padding:26px;
border-radius:14px;
box-shadow:0 8px 25px rgba(0,0,0,0.08);
transition:.3s;
display:flex;
flex-direction:column;
}

.card:hover{
transform:translateY(-6px);
box-shadow:0 18px 40px rgba(0,0,0,0.12);
}


.card-title{
font-size:20px;
font-weight:700;
margin-bottom:5px;
}


/* PRICE */

.price{
font-size:28px;
font-weight:700;
color:#111;
margin-bottom:10px;
}


/* borders */

.basic{
border-top:5px solid #0077ff;
}

.prime{
border-top:5px solid #ff6b00;
}


.features{
margin-top:10px;
line-height:1.7;
color:#444;
padding-left:0;
list-style:none;
}

.features li{
margin-bottom:8px;
font-size:14px;
}


/* badge */

.badge{
display:inline-block;
background:#e63946;
color:#fff;
padding:6px 12px;
border-radius:20px;
font-size:12px;
margin-bottom:10px;
}


/* assurance text */

.assure{
font-size:13px;
color:#666;
margin-top:10px;
margin-bottom:10px;
}


/* button */

.join-btn{
display:block;
text-align:center;
margin-top:auto;
background:#25D366;
color:white;
padding:12px;
border-radius:8px;
text-decoration:none;
font-weight:600;
font-size:14px;
transition:.3s;
}

.join-btn:hover{
background:#1ebe5d;
}


@media(max-width:900px){

.card{
flex:1 1 100%;
max-width:100%;
}

.heading h2{
font-size:24px;
}

}


@media(max-width:600px){

.heading h2{
font-size:22px;
}

.heading p{
font-size:14px;
}

.card{
padding:22px;
}

.features li{
font-size:13px;
}

.join-btn{
width:100%;
}

}

</style>

` }) %>
