<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Job Post - H&M</title>

<style>
body{
    font-family: 'Segoe UI', sans-serif;
    background: #f4f6f9;
}

.job-container{
    max-width: 850px;
    margin: 40px auto;
    background: #ffffff;
    padding: 35px;
    border-radius: 15px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.08);
}

.company-logo{
    width: 120px;
    margin-bottom: 15px;
}

.job-title{
    font-size: 28px;
    font-weight: 700;
    color: #111;
}

.company-name{
    font-size: 18px;
    color: #555;
    margin-bottom: 15px;
}

.badge{
    display: inline-block;
    background: #e63946;
    color: #fff;
    padding: 6px 14px;
    border-radius: 25px;
    font-size: 14px;
    margin: 5px 5px 10px 0;
}

.job-details{
    margin-top: 20px;
    line-height: 1.8;
    color: #444;
}

.apply-btn{
    display: inline-block;
    margin-top: 25px;
    background: #0077ff;
    color: #fff;
    padding: 12px 28px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: 0.3s;
}

.apply-btn:hover{
    background: #0056cc;
}

@media(max-width:600px){
    .job-container{
        padding: 20px;
    }
    .job-title{
        font-size: 22px;
    }
}
</style>
</head>

<body>

<div class="job-container">

    <img src="https://upload.wikimedia.org/wikipedia/commons/5/53/H%26M-Logo.svg" 
         alt="H&M Logo" class="company-logo">

    <div class="job-title">Associate Software Engineer</div>
    <div class="company-name">H&M Services India Pvt Ltd</div>

    <span class="badge">Full Time</span>
    <span class="badge">₹ 12,00,000 CTC</span>
    <span class="badge">Fresher (2024–2025)</span>

    <div class="job-details">
        <p><strong>Location:</strong> Bangalore, Karnataka, India</p>
        <p><strong>Drive Location:</strong> Bangalore</p>
        <p><strong>Job Roles:</strong></p>
        <ul>
            <li>Backend Engineering</li>
            <li>Mobile Development (Android / iOS)</li>
            <li>Site Reliability Engineering (SRE)</li>
        </ul>
        <p><strong>Company Website:</strong> 
           <a href="https://hmgroup.com" target="_blank">hmgroup.com</a>
        </p>
    </div>

    <a href="https://www.elitmus.com/jobs/33275-h-m-services-associate-software-engineer-bangalore"
       target="_blank"
       class="apply-btn">
       Apply Now
    </a>

</div>

</body>
</html>