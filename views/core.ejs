<%- include("./layouts/boilerplate", { body: `

<section class="plans-section">

<div class="container">

<!-- HEADING -->

<div class="heading text-center">

<h2>Core Engineering Job Access Plans</h2>

<p>
Get verified core engineering opportunities directly on WhatsApp.
Choose the plan that fits your career journey.
</p>

</div>



<!-- PLANS -->

<div class="plans-wrapper">

<!-- BASIC PLAN -->

<div class="plan-card">

<div class="badge basic-badge">Basic Access</div>

<h3 class="plan-title">Basic Core Subscription</h3>

<ul class="features">

<li>✔ Core engineering job updates</li>
<li>✔ Mechanical / Electrical / Civil roles</li>
<li>✔ Entry-level hiring alerts</li>
<li>✔ Regular WhatsApp job notifications</li>
<li>✔ Community WhatsApp group</li>

</ul>

<a href="/contact" class="join-btn whatsapp-btn">

<i class="fab fa-whatsapp"></i>
Join Basic Group

</a>

</div>



<!-- PRIME PLAN -->

<div class="plan-card prime">

<div class="popular">⭐ Most Popular</div>

<div class="badge premium-badge">Premium Access</div>

<h3 class="plan-title">Prime Core Subscription</h3>

<ul class="features">

<li>✔ Premium core engineering jobs</li>
<li>✔ PSU / Government hiring alerts</li>
<li>✔ Core MNC engineering roles</li>
<li>✔ Automobile / Power / Oil & Gas sector</li>
<li>✔ Early hiring drive access</li>
<li>✔ Premium WhatsApp group updates</li>

</ul>

<a href="/contact" class="join-btn prime-btn">

<i class="fab fa-whatsapp"></i>
Join Prime Group

</a>

</div>

</div>



<!-- COMPARISON TABLE -->

<div class="comparison">

<h3>Plan Comparison</h3>

<div class="table-wrapper">

<table>

<tr>
<th>Features</th>
<th>Basic</th>
<th>Prime</th>
</tr>

<tr>
<td>Verified Job Opportunities</td>
<td>✔</td>
<td>✔</td>
</tr>

<tr>
<td>Premium Job Alerts</td>
<td>—</td>
<td>✔</td>
</tr>

<tr>
<td>PSU / Government Hiring Updates</td>
<td>—</td>
<td>✔</td>
</tr>

<tr>
<td>Early Access to Hiring Drives</td>
<td>—</td>
<td>✔</td>
</tr>

<tr>
<td>WhatsApp Group Access</td>
<td>✔</td>
<td>✔ Premium</td>
</tr>

</table>

</div>

</div>


</div>

</section>



<style>

/* SECTION */

.plans-section{
background:#f4f6f9;
padding:70px 20px;
font-family:Poppins;
}

.container{
max-width:1100px;
margin:auto;
padding:0 20px;
}



/* HEADING */

.heading{
margin-bottom:50px;
}

.heading h2{
font-size:30px;
font-weight:700;
margin-bottom:10px;
}

.heading p{
color:#666;
font-size:15px;
}



/* PLAN GRID */

.plans-wrapper{
display:grid;
grid-template-columns:1fr 1fr;
gap:30px;
margin-bottom:60px;
}



/* CARD */

.plan-card{
background:#fff;
padding:30px;
border-radius:20px;
box-shadow:0 10px 30px rgba(0,0,0,0.08);
transition:0.3s;
display:flex;
flex-direction:column;
position:relative;
}

.plan-card:hover{
transform:translateY(-8px);
box-shadow:0 20px 60px rgba(0,0,0,0.12);
}



/* PRIME PLAN */

.prime{
background:linear-gradient(135deg,#ff6b00,#ff9d2f);
color:white;
}

.prime .features li{
color:white;
}

.prime-btn{
background:white;
color:#ff6b00;
}



/* BADGES */

.badge{
padding:6px 14px;
border-radius:20px;
font-size:12px;
margin-bottom:15px;
display:inline-block;
font-weight:600;
}

.basic-badge{
background:#0d6efd;
color:white;
}

.premium-badge{
background:#ff6b00;
color:white;
}



/* POPULAR TAG */

.popular{
position:absolute;
top:-12px;
right:15px;
background:#ff6b00;
color:#fff;
padding:6px 12px;
font-size:12px;
border-radius:8px;
}



/* TITLE */

.plan-title{
font-size:22px;
font-weight:700;
margin-bottom:15px;
}



/* FEATURES */

.features{
list-style:none;
padding:0;
margin-bottom:25px;
}

.features li{
margin-bottom:10px;
font-size:14px;
}



/* BUTTON */

.join-btn{
padding:14px;
border-radius:10px;
text-decoration:none;
text-align:center;
font-weight:600;
display:flex;
align-items:center;
justify-content:center;
gap:10px;
margin-top:auto;
}

.whatsapp-btn{
background:#25D366;
color:white;
}

.whatsapp-btn:hover{
background:#1ebe5d;
}

.prime-btn:hover{
opacity:0.9;
}



/* TABLE */

.comparison{
text-align:center;
}

.comparison h3{
margin-bottom:20px;
font-weight:700;
}

.table-wrapper{
overflow-x:auto;
}

table{
width:100%;
border-collapse:collapse;
background:#fff;
box-shadow:0 8px 25px rgba(0,0,0,0.08);
border-radius:12px;
min-width:500px;
}

th,td{
padding:14px;
border-bottom:1px solid #eee;
text-align:center;
}

th{
background:#0d6efd;
color:#fff;
}

td{
font-size:14px;
}



/* MOBILE */

@media(max-width:768px){

.heading h2{
font-size:24px;
}

.plans-wrapper{
grid-template-columns:1fr;
gap:25px;
}

.plan-card{
width:100%;
}

.features li{
font-size:13px;
}

}

</style>

` }) %>