Join WhatsApp groups to receive verified Core Engineering job opportunities.
</p>

</div>



<!-- PLANS -->

<div class="plans-wrapper">

<!-- BASIC PLAN -->

<div class="plan-card basic">

<div class="badge">Basic Core Access</div>

<h3 class="plan-title">
Basic Core Subscription
</h3>

<ul class="features">

<li>✔ Mechanical Engineering Jobs</li>
<li>✔ Electrical Engineering Jobs</li>
<li>✔ Civil Engineering Jobs</li>
<li>✔ Chemical Engineering Jobs</li>
<li>✔ Packages between 3 – 6 LPA</li>
<li>✔ Fresher Core Opportunities</li>

</ul>

<a href="/contact"
class="join-btn">
Join Core Basic WhatsApp Group
</a>

</div>



<!-- PRIME PLAN -->

<div class="plan-card prime">

<div class="badge">Premium Core Access</div>

<h3 class="plan-title">
Prime Core Subscription
</h3>

<ul class="features">

<li>✔ High Package Core Jobs</li>
<li>✔ PSU & Government Opportunities</li>
<li>✔ Core MNC Engineering Roles</li>
<li>✔ Oil & Gas / Automobile / Power Sector</li>
<li>✔ Packages between 6 – 20 LPA</li>
<li>✔ Premium Core Job Alerts</li>

</ul>

<a href="/contact"
class="join-btn">
Join Core Prime WhatsApp Group
</a>

</div>

</div>

</div>

</section>



<style>

/* NAVBAR */

.navbar{
padding:10px 0;
}

.navbar-brand small{
font-size:11px;
line-height:1;
}

.nav-link{
font-weight:500;
}



/* SECTION */

.plans-section{
background:#f4f6f9;
padding:60px 15px;
}

.container{
max-width:1100px;
margin:auto;
}



/* HEADING */

.heading{
margin-bottom:40px;
}

.heading h2{
font-size:28px;
font-weight:700;
margin-bottom:10px;
}

.heading p{
color:#666;
}



/* WRAPPER */

.plans-wrapper{
display:flex;
gap:20px;
flex-wrap:wrap;
justify-content:center;
max-width:900px;
margin:auto;
}



/* CARD */

.plan-card{
background:#fff;
flex:1 1 380px;
max-width:420px;
padding:25px;
border-radius:14px;
box-shadow:0 8px 25px rgba(0,0,0,0.08);
transition:.3s;
display:flex;
flex-direction:column;
}

.plan-card:hover{
transform:translateY(-6px);
box-shadow:0 20px 45px rgba(0,0,0,0.12);
}



/* BORDER */

.basic{
border-top:5px solid #0077ff;
}

.prime{
border-top:5px solid #ff6b00;
}



/* BADGE */

.badge{
background:#e63946;
color:#fff;
padding:6px 14px;
border-radius:20px;
font-size:12px;
display:inline-block;
margin-bottom:10px;
}



/* TITLE */

.plan-title{
font-size:20px;
font-weight:700;
margin-bottom:12px;
}



/* FEATURES */

.features{
list-style:none;
padding:0;
margin:10px 0;
}

.features li{
font-size:14px;
margin-bottom:8px;
color:#444;
}



/* BUTTON */

.join-btn{
margin-top:auto;
background:#25D366;
color:#fff;
text-align:center;
padding:12px;
border-radius:8px;
text-decoration:none;
font-weight:600;
font-size:14px;
transition:.3s;
}

.join-btn:hover{
background:#1ebe5d;
}



/* TABLET */

@media(max-width:900px){

.heading h2{
font-size:24px;
}

.plan-card{
flex:1 1 100%;
max-width:100%;
}

}



/* MOBILE */

@media(max-width:600px){

.plans-section{
padding:40px 10px;
}

.heading h2{
font-size:22px;
}

.heading p{
font-size:14px;
}

.plan-card{
padding:20px;
}

.features li{
font-size:13px;
}

.join-btn{
width:100%;
}

}

</style>

` }) %>