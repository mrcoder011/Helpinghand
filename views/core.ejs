<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Core Engineering Job Access</title>

<style>

body{
font-family:'Segoe UI',sans-serif;
background:#f4f6f9;
}

.container{
max-width:1000px;
margin:50px auto;
padding:20px;
}

.heading{
text-align:center;
margin-bottom:40px;
}

.heading h2{
font-size:30px;
font-weight:700;
color:#111;
}

.cards{
display:flex;
gap:25px;
flex-wrap:wrap;
justify-content:center;
}

.card{
background:#fff;
width:420px;
padding:30px;
border-radius:16px;
box-shadow:0 8px 25px rgba(0,0,0,0.08);
transition:.3s;
}

.card:hover{
transform:translateY(-8px);
box-shadow:0 18px 40px rgba(0,0,0,0.15);
}

.card-title{
font-size:24px;
font-weight:700;
margin-bottom:15px;
}

.basic{
border-top:5px solid #0077ff;
}

.prime{
border-top:5px solid #ff6b00;
}

.features{
margin-top:15px;
line-height:1.8;
color:#444;
}

.features li{
margin-bottom:8px;
}

.badge{
display:inline-block;
background:#e63946;
color:#fff;
padding:6px 12px;
border-radius:20px;
font-size:13px;
margin-bottom:10px;
}

.join-btn{
display:block;
text-align:center;
margin-top:25px;
background:#25D366;
color:white;
padding:12px;
border-radius:8px;
text-decoration:none;
font-weight:600;
transition:.3s;
}

.join-btn:hover{
background:#1ebe5d;
}

@media(max-width:768px){

.cards{
flex-direction:column;
align-items:center;
}

.card{
width:100%;
}

}

</style>
</head>

<body>

<div class="container">

<div class="heading">
<h2>Core Engineering Job Access Plans</h2>
<p>Join WhatsApp groups to receive verified Core Engineering job opportunities.</p>
</div>

<div class="cards">

<!-- BASIC PLAN -->
<div class="card basic">

<div class="badge">Basic Core Access</div>

<div class="card-title">
Basic Core Subscription
</div>

<ul class="features">

<li>✔ Mechanical Engineering Jobs</li>
<li>✔ Electrical Engineering Jobs</li>
<li>✔ Civil Engineering Jobs</li>
<li>✔ Chemical Engineering Jobs</li>
<li>✔ Packages between 3 – 6 LPA</li>
<li>✔ Fresher Core Opportunities</li>

</ul>

<a href="https://chat.whatsapp.com/your-group-link"
class="join-btn">
Join Core Basic WhatsApp Group
</a>

</div>


<!-- PRIME PLAN -->
<div class="card prime">

<div class="badge">Premium Core Access</div>

<div class="card-title">
Prime Core Subscription
</div>

<ul class="features">

<li>✔ High Package Core Jobs</li>
<li>✔ PSU & Government Opportunities</li>
<li>✔ Core MNC Engineering Roles</li>
<li>✔ Oil & Gas / Automobile / Power Sector</li>
<li>✔ Packages between 6 – 20 LPA</li>
<li>✔ Premium Core Job Alerts</li>

</ul>

<a href="https://chat.whatsapp.com/your-group-link"
class="join-btn">
Join Core Prime WhatsApp Group
</a>

</div>

</div>

</div>

</body>
</html>