<%- include("layouts/boilerplate", { body: `

<style>

body{
background:#f1f5f9;
font-family:'Poppins',sans-serif;
}

.contact-wrapper{
max-width:900px;
margin:auto;
}

/* FORM CARD */

.form-card{
background:#ffffff;
padding:40px;
border-radius:14px;
box-shadow:0 12px 35px rgba(0,0,0,0.08);
margin-bottom:30px;
}

/* PAYMENT CARD */

.payment-box{
background:#ffffff;
padding:35px 25px;
border-radius:14px;
box-shadow:0 12px 35px rgba(0,0,0,0.08);
text-align:center;
}

.qr-box{
display:flex;
justify-content:center;
margin:20px 0;
}

/* QR BLUR */

.qr-wrapper{
position:relative;
display:inline-block;
cursor:pointer;
}

.qr-wrapper img{
width:200px;
border-radius:10px;
box-shadow:0 6px 18px rgba(0,0,0,0.15);
filter:blur(8px);
transition:0.4s;
}

.qr-wrapper.active img{
filter:blur(0);
}

.qr-overlay{
position:absolute;
top:0;
left:0;
width:100%;
height:100%;
display:flex;
align-items:center;
justify-content:center;
background:rgba(0,0,0,0.45);
color:#fff;
font-weight:600;
border-radius:10px;
text-align:center;
padding:10px;
font-size:14px;
}

.qr-wrapper.active .qr-overlay{
display:none;
}

.payment-note{
font-size:14px;
color:#64748b;
}

.submit-btn{
font-weight:600;
padding:12px;
border-radius:8px;
}

/* screenshot preview */

#screenshotPreview{
display:none;
margin-top:10px;
width:150px;
border-radius:8px;
box-shadow:0 4px 10px rgba(0,0,0,0.2);
}

/* MOBILE */

@media(max-width:768px){

.form-card{
padding:25px;
}

.qr-wrapper img{
width:170px;
}

}

</style>



<script>

/* QR REVEAL */

function revealQR(){
const qr=document.getElementById("qrWrapper");
qr.classList.add("active");
}

/* Screenshot preview */

function previewScreenshot(event){

const preview=document.getElementById("screenshotPreview");
const file=event.target.files[0];

if(file){
preview.src=URL.createObjectURL(file);
preview.style.display="block";
}

}

/* Resume validation */

function validateResume(input){

const file=input.files[0];

if(file){
if(file.type!=="application/pdf"){
alert("Please upload resume in PDF format only");
input.value="";
}
}

}

/* Payment timer */

let time=600;

setInterval(()=>{

let minutes=Math.floor(time/60);
let seconds=time%60;

document.getElementById("paymentTimer").innerText=
minutes+":"+(seconds<10?"0":"")+seconds;

time--;

if(time<0){
document.getElementById("paymentTimer").innerText="Expired";
}

},1000);

</script>



<div class="container mt-5 mb-5 contact-wrapper">


<!-- FORM FIRST -->

<div class="form-card">

<form action="/contact" method="POST" enctype="multipart/form-data">

<!-- HEADING -->

<div class="text-center mb-4">

<h3 class="fw-bold text-primary">
Connect With Us
</h3>

<p class="text-muted small">
Please fill in the details below to connect with our team.  
We will review your information and contact you soon.
</p>

</div>


<!-- NAME + DOB -->

<div class="row">

<div class="col-md-6">
<label class="form-label">Full Name*</label>
<input type="text" class="form-control mb-3" name="fullName" placeholder="Enter your full name" required>
</div>

<div class="col-md-6">
<label class="form-label">Date of Birth*</label>
<input type="date" class="form-control mb-3" name="dob" required>
</div>

</div>


<!-- MOBILE -->

<label class="form-label">Mobile Number*</label>
<input type="tel" class="form-control mb-3" name="mobile" placeholder="Enter your mobile number" required>


<!-- REASON -->

<label class="form-label">Reason for Contact*</label>

<textarea 
class="form-control mb-3"
name="reason"
rows="3"
placeholder="Tell us why you want to connect with us"
required></textarea>


<!-- COURSE + DESIGNATION -->

<div class="row">

<div class="col-md-6">
<label class="form-label">Course / Branch*</label>
<input type="text" class="form-control mb-3" name="course" placeholder="Example: B.Tech Mechanical" required>
</div>

<div class="col-md-6">
<label class="form-label">Current Designation*</label>
<input type="text" class="form-control mb-3" name="designation" placeholder="Student / Graduate / Working Professional" required>
</div>

</div>


<!-- PURSUING -->

<label class="form-label">Are you currently pursuing your course?*</label>

<select class="form-select mb-3" name="pursuing" required>
<option disabled selected>Select</option>
<option>Yes</option>
<option>No</option>
</select>


<!-- LOCATION -->

<label class="form-label">Current Location*</label>
<input type="text" class="form-control mb-3" name="location" placeholder="City, State" required>


<!-- CONTACT MODE -->

<label class="form-label">Preferred Mode of Contact*</label>

<select class="form-select mb-3" name="contactMode" required>
<option disabled selected>Select</option>
<option>Online Meeting</option>
<option>Phone Call</option>
<option>Email</option>
<option>Not Applicable</option>
</select>


<!-- RESUME -->

<label class="form-label">Upload Resume*</label>

<input 
type="file"
class="form-control mb-3"
name="resume"
accept=".pdf"
onchange="validateResume(this)"
required>


<!-- PAYMENT SCREENSHOT -->

<label class="form-label">
If you donated, upload Payment Screenshot (Optional)
</label>

<input
type="file"
class="form-control mb-3"
name="paymentScreenshot"
accept="image/*"
onchange="previewScreenshot(event)">

<img id="screenshotPreview" style="max-width:200px;margin-top:10px;">


<!-- SUBMIT -->

<button type="submit" class="btn btn-primary w-100 submit-btn">
Submit Details
</button>

</form>

</div>


<!-- OPTIONAL DONATION SECTION -->

<div class="payment-box">

<h5 class="text-primary fw-bold">
Support Our Mission
</h5>

<p class="payment-note">
If you would like to support our website and help us continue empowering students 
with real career opportunities, you may choose to donate.
</p>

<p class="payment-note">
<b>Donation is completely optional.</b>
</p>

<div class="qr-box">

<div id="qrWrapper" class="qr-wrapper" onclick="revealQR()">

<img src="/images/upi-qr.jpeg" alt="UPI QR Code">

<div class="qr-overlay">
Tap to reveal QR
</div>

</div>

</div>

<p class="mt-2 fw-semibold">
UPI ID: 7488663980@ybl
</p>

<div style="margin-top:15px;font-size:14px;color:#64748b">

Payment session expires in  
<b id="paymentTimer">10:00</b>

</div>

</div>


</div>

` }) %>