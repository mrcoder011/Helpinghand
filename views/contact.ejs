<%- include("layouts/boilerplate", { body: `

<style>

body{
background:#f1f5f9;
font-family:'Poppins',sans-serif;
}

.contact-wrapper{
max-width:1200px;
margin:auto;
}

/* FORM CARD */

.form-card{
background:#ffffff;
padding:40px;
border-radius:14px;
box-shadow:0 12px 35px rgba(0,0,0,0.08);
}

/* PAYMENT CARD */

.payment-box{
background:#ffffff;
padding:35px 25px;
border-radius:14px;
box-shadow:0 12px 35px rgba(0,0,0,0.08);
text-align:center;
position:sticky;
top:110px;
}

.qr-box{
display:flex;
justify-content:center;
margin:20px 0;
}

.qr-box img{
width:200px;
border-radius:10px;
box-shadow:0 6px 18px rgba(0,0,0,0.15);
}

.payment-note{
font-size:14px;
color:#64748b;
}

.submit-btn{
font-weight:600;
padding:12px;
border-radius:8px;
}

/* screenshot preview */

#screenshotPreview{
display:none;
margin-top:10px;
width:150px;
border-radius:8px;
box-shadow:0 4px 10px rgba(0,0,0,0.2);
}

@media(max-width:768px){

.form-card{
padding:25px;
}

.payment-box{
margin-top:25px;
position:relative;
top:0;
}

.qr-box img{
width:170px;
}

}

</style>



<script>

/* Screenshot preview */

function previewScreenshot(event){

const preview=document.getElementById("screenshotPreview");
const file=event.target.files[0];

if(file){

preview.src=URL.createObjectURL(file);
preview.style.display="block";

}

}


/* Resume validation */

function validateResume(input){

const file=input.files[0];

if(file){

if(file.type!=="application/pdf"){

alert("Please upload resume in PDF format only");
input.value="";

}

}

}


/* Payment countdown timer */

let time=600;

setInterval(()=>{

let minutes=Math.floor(time/60);
let seconds=time%60;

document.getElementById("paymentTimer").innerText=
minutes+":"+(seconds<10?"0":"")+seconds;

time--;

if(time<0){

document.getElementById("paymentTimer").innerText="Expired";

}

},1000);

</script>



<div class="container mt-5 mb-5 contact-wrapper">

<div class="row g-4 align-items-start">

<!-- LEFT SIDE FORM -->

<div class="col-lg-8">

<div class="form-card">

<form action="/contact" method="POST" enctype="multipart/form-data">

<h3 class="mb-4 text-center text-primary fw-bold">
Contact Us
</h3>


<div class="row">

<div class="col-md-6">
<label class="form-label">Full Name*</label>
<input type="text" class="form-control mb-3" name="fullName" required>
</div>

<div class="col-md-6">
<label class="form-label">Date of Birth*</label>
<input type="date" class="form-control mb-3" name="dob" required>
</div>

</div>


<label class="form-label">Mobile Number*</label>
<input type="tel" class="form-control mb-3" name="mobile" required>


<label class="form-label">Contact us for (Reason)*</label>
<textarea class="form-control mb-3" name="skills" rows="3" required></textarea>


<div class="row">

<div class="col-md-6">
<label class="form-label">Course / Branch*</label>
<input type="text" class="form-control mb-3" name="company" required>
</div>

<div class="col-md-6">
<label class="form-label">Current Designation*</label>
<input type="text" class="form-control mb-3" name="designation" required>
</div>

</div>


<label class="form-label">Are you currently pursuing?*</label>

<select class="form-select mb-3" name="negotiable" required>
<option disabled selected>Select</option>
<option>Yes</option>
<option>No</option>
</select>


<label class="form-label">Current Location*</label>
<input type="text" class="form-control mb-3" name="location" required>


<label class="form-label">Preferred Mode for Contact*</label>

<select class="form-select mb-3" name="workMode" required>
<option disabled selected>Select</option>
<option>Online Meeting</option>
<option>Call</option>
</select>


<label class="form-label">Upload Resume*</label>

<input 
type="file"
class="form-control mb-3"
name="resume"
accept=".pdf"
onchange="validateResume(this)"
required>


<label class="form-label">Upload Payment Screenshot*</label>

<input
type="file"
class="form-control mb-3"
name="paymentScreenshot"
accept="image/*"
onchange="previewScreenshot(event)"
required>

<img id="screenshotPreview">


<button type="submit" class="btn btn-primary w-100 submit-btn">
Submit Application
</button>

</form>

</div>

</div>



<!-- RIGHT SIDE PAYMENT -->

<div class="col-lg-4">

<div class="payment-box">

<h5 class="text-primary fw-bold">
Scan & Pay
</h5>

<p class="payment-note">
Please scan the QR code and complete the payment before submitting the form.
</p>

<div class="qr-box">
<img src="/images/upi-qr.jpeg" alt="UPI QR Code">
</div>

<p class="mt-2 fw-semibold">
UPI ID: 7488663980@ybl
</p>


<a href="upi://pay?pa=7488663980@ybl&pn=Amupro&cu=INR"
class="btn btn-success w-100 mt-2">

Pay via UPI

</a>


<div style="margin-top:15px;font-size:14px;color:#64748b">

Payment session expires in  
<b id="paymentTimer">10:00</b>

</div>

<p class="payment-note mt-2">
After completing the payment, upload the screenshot in the form.
</p>

</div>

</div>


</div>

</div>

` }) %>