<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Contact Us Form</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Font Awesome -->
  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>

  <style>
    body {
      background: #f0f4f8;
      padding-top: 90px; /* navbar space */
    }

    form {
      max-width: 850px;
      margin: auto;
      background: #fff;
      padding: 40px;
      border-radius: 12px;
      box-shadow: 0 8px 30px rgba(0,0,0,0.1);
    }

    .navbar-brand {
      font-weight: 700;
      font-size: 22px;
      color: #0d6efd !important;
    }

    .notification-badge {
      position: absolute;
      top: -6px;
      right: -6px;
      background: red;
      color: white;
      font-size: 11px;
      padding: 2px 6px;
      border-radius: 50%;
    }

    footer a {
      text-decoration: none;
      color: #555;
    }

    footer a:hover {
      color: #0d6efd;
    }
  </style>
</head>

<body>

<!-- ================= NAVBAR ================= -->
<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm fixed-top">
  <div class="container">

    <a class="navbar-brand d-flex align-items-center" href="/">
      <i class="fa-solid fa-handshake-angle me-2 text-primary"></i>
      Amupro
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
      data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
      <ul class="navbar-nav align-items-center">
        <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
        <li class="nav-item"><a class="nav-link" href="/about">About</a></li>
        <li class="nav-item"><a class="nav-link active" href="/contact">Contact</a></li>

        <li class="nav-item position-relative ms-3">
          <i class="fa-solid fa-bell fs-5"></i>
          <span class="notification-badge">100+</span>
        </li>
      </ul>
    </div>

  </div>
</nav>
<!-- =============== NAVBAR END =============== -->


<!-- ================= FORM ================= -->
<div class="container mb-5">
  <form action="/contact" method="POST" enctype="multipart/form-data">

    <h3 class="mb-4 text-center text-primary fw-bold">
      Contact us Form!
    </h3>

    <div class="row">
      <div class="col-md-6">
        <label class="form-label">Full Name*</label>
        <input type="text" class="form-control mb-3" name="fullName" required>
      </div>

      <div class="col-md-6">
        <label class="form-label">Date of Birth*</label>
        <input type="date" class="form-control mb-3" name="dob" required>
      </div>
    </div>

    <label class="form-label">Mobile Number*</label>
    <input type="tel" class="form-control mb-3" name="mobile" required>

    <label class="form-label">Contact us for (Reason)*</label>
    <textarea class="form-control mb-3" name="skills" required></textarea>

    <div class="row">
      <div class="col-md-6">
        <label class="form-label">Course/Branch*</label>
        <input type="text" class="form-control mb-3" name="company" required>
      </div>

      <div class="col-md-6">
        <label class="form-label">Current Designation*</label>
        <input type="text" class="form-control mb-3" name="designation" required>
      </div>
    </div>

    <label class="form-label">Are you currently pursuing?*</label>
    <select class="form-select mb-3" name="negotiable" required>
      <option disabled selected>Select</option>
      <option>Yes</option>
      <option>No</option>
    </select>

    <label class="form-label">Current Location*</label>
    <input type="text" class="form-control mb-3" name="location" required>

    <label class="form-label">Preferred Mode for Contact*</label>
    <select class="form-select mb-3" name="workMode" required>
      <option disabled selected>Select</option>
      <option>Online Meeting</option>
      <option>Call</option>
    </select>

    <label class="form-label">Upload Resume*</label>
    <input type="file" class="form-control mb-4" name="resume" required>

    <button type="submit" class="btn btn-primary w-100 py-2">
      Submit Application
    </button>

  </form>
</div>
<!-- =============== FORM END =============== -->


<!-- ================= FOOTER ================= -->
<footer class="bg-light pt-5 pb-3">
  <div class="container">
    <div class="row">

      <div class="col-md-3 mb-4">
        <h5>
          <i class="fa-solid fa-handshake-angle me-2 text-primary"></i>
          Amupro
        </h5>
        <ul class="list-unstyled">
          <li><a href="/about">About Us</a></li>
          <li><a href="#">Investor Relations</a></li>
          <li><a href="#">Terms & Conditions</a></li>
          <li><a href="#">Privacy Policy</a></li>
        </ul>
      </div>

      <div class="col-md-3 mb-4">
        <h6>For Students</h6>
        <ul class="list-unstyled">
          <li><a href="/listings">Browse Opportunities</a></li>
          <li><a href="/contact">Contact Us</a></li>
        </ul>
      </div>

      <div class="col-md-3 mb-4">
        <h6>For Professionals</h6>
        <ul class="list-unstyled">
          <li><a href="#">Register as Professional</a></li>
        </ul>
      </div>

      <div class="col-md-3 mb-4">
        <h6>Social Links</h6>
        <div class="d-flex gap-3">
          <a href="#"><i class="fab fa-twitter fa-lg"></i></a>
          <a href="#"><i class="fab fa-facebook fa-lg"></i></a>
          <a href="#"><i class="fab fa-instagram fa-lg"></i></a>
          <a href="#"><i class="fab fa-linkedin fa-lg"></i></a>
        </div>
      </div>

    </div>

    <div class="text-center text-muted small mt-4 border-top pt-3">
      © 2026 Amupro Pvt. Ltd.
    </div>
  </div>
</footer>
<!-- =============== FOOTER END =============== -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>