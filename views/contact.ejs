<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Job Application Form</title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Font Awesome -->
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
  />

  <style>
    body {
      background: #f0f4f8;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      margin: 0;
      padding: 0;
      padding-top: 80px; /* FIXED NAVBAR SPACE */
    }

    /* ===== NAVBAR ===== */
    .navbar-brand {
      font-weight: 700;
      font-size: 22px;
      color: #0d6efd !important;
    }

    .nav-link {
      font-weight: 500;
      margin-right: 15px;
    }

    .notification-badge {
      position: absolute;
      top: -6px;
      right: -6px;
      background: red;
      color: white;
      font-size: 11px;
      padding: 2px 6px;
      border-radius: 50%;
    }

    /* ===== FORM ===== */
    form {
      max-width: 800px;
      margin: 50px auto;
      padding: 40px;
      background: #ffffff;
      border-radius: 12px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
      animation: fadeIn 0.6s ease-in-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .form-label {
      display: block;
      margin-bottom: 8px;
      font-weight: 600;
      color: #333;
    }

    .form-control,
    .form-select {
      width: 100%;
      padding: 12px 15px;
      margin-bottom: 20px;
      border: 1px solid #ccc;
      border-radius: 8px;
      background: #f9f9f9;
    }

    textarea.form-control {
      resize: vertical;
      min-height: 100px;
    }

    .btn-primary {
      background-color: #007bff;
      border: none;
      padding: 14px 30px;
      font-weight: bold;
      border-radius: 8px;
    }

    /* ===== FOOTER ===== */
    footer a {
      color: #555;
      text-decoration: none;
    }

    footer a:hover {
      color: #0d6efd;
      text-decoration: underline;
    }
  </style>
</head>

<body>

<!-- ================= FIXED NAVBAR ================= -->
<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm fixed-top">
  <div class="container">

    <!-- SAME LOGO AS FOOTER -->
    <a class="navbar-brand d-flex align-items-center" href="/">
      <i class="fa-solid fa-handshake-angle me-2 text-primary"></i>
      Amupro
    </a>

    <div class="collapse navbar-collapse justify-content-end">
      <ul class="navbar-nav align-items-center">
        <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
        <li class="nav-item"><a class="nav-link" href="/about">About</a></li>
        <li class="nav-item"><a class="nav-link" href="/contact">Contact us!</a></li>

        <li class="nav-item position-relative ms-3">
          <i class="fa-solid fa-bell fs-5"></i>
          <span class="notification-badge">100+</span>
        </li>
      </ul>
    </div>
  </div>
</nav>
<!-- =============== NAVBAR END =============== -->


<!-- ================= JOB FORM ================= -->
<form action="/contact" method="POST" enctype="multipart/form-data">

  <label class="form-label">Full Name (as per Profile)*</label>
  <input type="text" class="form-control" name="fullName" required>

  <label class="form-label">Date of Birth*</label>
  <input type="date" class="form-control" name="dob" required>

  <label class="form-label">Mobile Number*</label>
  <input type="tel" class="form-control" name="mobile" required>

  <!--<label class="form-label">PAN Number*</label>
  <input type="text" class="form-control" name="pan">!-->

  <!--<label class="form-label">Total Experience (Years)*</label>
  <input type="number" step="0.1" class="form-control" name="totalExp">!-->

  <!--<label class="form-label">Relevant Experience (Years)*</label>
  <input type="number" step="0.1" class="form-control" name="relevantExp" >!-->

  <label class="form-label">Contact us for (Reason)*</label>
  <textarea class="form-control" name="skills" required></textarea>

  <!--<label class="form-label">Experience in Role*</label>
  <input type="text" class="form-control" name="roleExp" >!-->

  <label class="form-label">Branch*</label>
  <input type="text" class="form-control" name="company" required>

  <label class="form-label">Current Designation/Role*</label>
  <input type="text" class="form-control" name="designation" required>

  <!--<label class="form-label">Notice Period*</label>
  <input type="text" class="form-control" name="noticePeriod" >!-->

  <label class="form-label">Is You are currently Persuing*</label>
  <select class="form-select" name="negotiable" required>
    <option disabled selected>Select</option>
    <option>Yes</option>
    <option>No</option>
  </select>

  <!--<label class="form-label">Expected *</label>
  <input type="number" step="0.1" class="form-control" name="ctc" > !-->

  <label class="form-label">Current Location*</label>
  <input type="text" class="form-control" name="location" required>

  <label class="form-label">Preferred Mode for contact *</label>
  <select class="form-select" name="workMode" required>
    <option disabled selected>Select</option>
    <option>Online Meeting</option>
    <option>Call</option>
   
  </select>

  <label class="form-label">Upload Resume / CV*</label>
  <input type="file" class="form-control" name="resume" required>

  <button type="submit" class="btn btn-primary mt-3">Submit Application</button>
</form>
<!-- =============== FORM END =============== -->


<!-- ================= FOOTER ================= -->
<footer class="footer bg-light pt-5 pb-3 mt-5">
  <div class="container">
    <div class="row text-start">

      <div class="col-md-3 mb-4">
        <h5>
          <i class="fa-solid fa-handshake-angle me-2 text-primary"></i>
          Amupro
        </h5>
        <ul class="list-unstyled">
          <li><a href="/about">About us</a></li>
          <li><a href="#">Investor Relations</a></li>
          <li><a href="/terms">Terms & Conditions</a></li>
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="#">Careers</a></li>
        </ul>
      </div>

      <div class="col-md-3 mb-4">
        <h6>For Customers</h6>
        <ul class="list-unstyled">
          <li><a href="#">Reviews</a></li>
          <li><a href="#">Categories Near You</a></li>
          <li><a href="/contact">Contact Us</a></li>
        </ul>
      </div>

      <div class="col-md-3 mb-4">
        <h6>For Professionals</h6>
        <ul class="list-unstyled">
          <li><a href="#">Register as a Professional</a></li>
        </ul>
      </div>

      <div class="col-md-3 mb-4">
        <h6>Social Links</h6>
        <div class="d-flex gap-3 mb-3">
          <a href="#"><i class="fab fa-twitter fa-lg"></i></a>
          <a href="#"><i class="fab fa-facebook fa-lg"></i></a>
          <a href="#"><i class="fab fa-instagram fa-lg"></i></a>
          <a href="#"><i class="fab fa-linkedin fa-lg"></i></a>
        </div>
      </div>
    </div>

    <div class="text-muted small mt-4 border-top pt-3 text-center">
      © 2025 Amupro Pvt. Ltd.
    </div>
  </div>
</footer>
<!-- =============== FOOTER END =============== -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
