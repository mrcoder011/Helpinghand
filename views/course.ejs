}



/* GRID */

.courses-wrapper{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
gap:25px;
}



/* CARD */

.course-card{
background:#fff;
border-radius:14px;
box-shadow:0 10px 30px rgba(0,0,0,0.08);
overflow:hidden;
display:flex;
flex-direction:column;
transition:.3s;
position:relative;
}

.course-card:hover{
transform:translateY(-8px);
box-shadow:0 25px 60px rgba(0,0,0,0.15);
}



/* IMAGE */

.course-img{
width:100%;
height:170px;
object-fit:cover;
}



/* BODY */

.course-body{
padding:20px;
display:flex;
flex-direction:column;
flex:1;
}



/* TITLE */

.course-body h3{
font-size:20px;
margin-bottom:8px;
font-weight:700;
}



/* RATING */

.rating{
color:#f59e0b;
font-size:14px;
margin-bottom:10px;
}

.rating span{
