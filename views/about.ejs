<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Amupro - About</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

<style>
body {
  font-family: 'Poppins', sans-serif;
  background: #f5f7fb;
}

/* Navbar */
.navbar {
  background: #ffffff;
  border-bottom: 1px solid #eee;
}

.navbar-brand {
  font-weight: 700;
  color: #0d6efd !important;
}

/* Hero */
.hero-section {
  padding: 50px 20px 30px;
  text-align: center;
}

.hero-section h1 {
  font-weight: 700;
  font-size: 22px;
  color: #0d6efd;
}

.hero-section p {
  font-size: 14px;
  color: #666;
}

/* Cards */
.custom-card {
  background: #ffffff;
  border-radius: 18px;
  padding: 20px;
  box-shadow: 0 8px 25px rgba(0,0,0,0.05);
}

.feature-list {
  list-style: none;
  padding: 0;
}

.feature-list li {
  padding: 8px 0;
  font-size: 14px;
  border-bottom: 1px solid #f0f0f0;
}

/* Team Section */
.team-card {
  background: #ffffff;
  border-radius: 20px;
  padding: 30px;
  box-shadow: 0 10px 35px rgba(0,0,0,0.06);
  transition: 0.3s;
  text-align: center;
  height: 100%;
}

.team-card:hover {
  transform: translateY(-5px);
}

.team-icon {
  width: 70px;
  height: 70px;
  border-radius: 50%;
  background: linear-gradient(135deg, #0d6efd, #6610f2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28px;
  margin: 0 auto 15px auto;
}

/* CTA */
.cta-section {
  text-align: center;
  padding: 40px 20px;
}

.cta-section .btn {
  width: 100%;
  border-radius: 30px;
  padding: 12px;
  font-weight: 600;
}

/* Footer */
footer {
  background: #ffffff;
  font-size: 14px;
}

footer a {
  text-decoration: none;
  color: #555;
}

footer a:hover {
  color: #0d6efd;
}
</style>
</head>

<body>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg sticky-top shadow-sm">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center" href="/">
      <i class="fa-solid fa-handshake-angle me-2 text-primary"></i>
      Amupro
    </a>
  </div>
</nav>

<!-- HERO -->
<div class="hero-section">
  <h1>Empowering Campus Youth for Better Career Opportunities</h1>
  <p>
    Many students struggle to find the right path due to lack of guidance,
    exposure and connections. Amupro helps students move confidently toward success.
  </p>
</div>

<div class="container">

  <!-- Challenges + Help -->
  <div class="row g-3 mb-5">
    <div class="col-12 col-md-6">
      <div class="custom-card">
        <h4 class="text-danger mb-3">Challenges Students Face</h4>
        <ul class="feature-list">
          <li>Lack of industry exposure</li>
          <li>No proper mentorship</li>
          <li>Difficulty getting referrals</li>
          <li>Interview preparation confusion</li>
          <li>Limited global access</li>
        </ul>
      </div>
    </div>

    <div class="col-12 col-md-6">
      <div class="custom-card">
        <h4 class="text-success mb-3">How Amupro Helps</h4>
        <ul class="feature-list">
          <li>Verified Job & Internship Opportunities</li>
          <li>Alumni Referral Support</li>
          <li>One-to-One Career Guidance</li>
          <li>Interview Preparation Guides</li>
          <li>Personal Mentorship</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- FOUNDING TEAM -->
  <div class="text-center mb-4">
    <h3 class="fw-bold text-primary">Founding Team</h3>
    <p class="text-muted">Leadership driving Amupro’s mission forward</p>
  </div>

  <div class="row g-4 mb-5">

    <!-- Founder -->
    <div class="col-12 col-md-4">
      <div class="team-card">
        <div class="team-icon">
          <i class="fa-solid fa-user-tie"></i>
        </div>
        <h6 class="text-muted mb-1">Founder</h6>
        <h5 class="fw-bold text-primary">Md Shafatullah</h5>
        <a href="https://www.linkedin.com/in/md-shafatullah-6a22541a6"
           target="_blank"
           class="btn btn-outline-primary btn-sm mt-2">
           <i class="fab fa-linkedin me-2"></i> LinkedIn Profile
        </a>
      </div>
    </div>

    <!-- Co-Founder Safiullah -->
    <div class="col-12 col-md-4">
      <div class="team-card">
        <div class="team-icon">
          <i class="fa-solid fa-user-gear"></i>
        </div>
        <h6 class="text-muted mb-1">Co-Founder</h6>
        <h5 class="fw-bold text-primary">Safiullah</h5>
        <a href="https://www.linkedin.com/in/safiullah-rahmani-a90695378"
           target="_blank"
           class="btn btn-outline-primary btn-sm mt-2">
           <i class="fab fa-linkedin me-2"></i> LinkedIn Profile
        </a>
      </div>
    </div>

    <!-- Co-Founder Abu Bilal -->
    <div class="col-12 col-md-4">
      <div class="team-card">
        <div class="team-icon">
          <i class="fa-solid fa-user"></i>
        </div>
        <h6 class="text-muted mb-1">Co-Founder</h6>
        <h5 class="fw-bold text-primary">Abu Bilal</h5>
        <a href="https://www.linkedin.com/in/abu-bilal-120167349"
           target="_blank"
           class="btn btn-outline-primary btn-sm mt-2">
           <i class="fab fa-linkedin me-2"></i> LinkedIn Profile
        </a>
      </div>
    </div>

  </div>

</div>

<!-- CTA -->
<div class="cta-section">
  <h3 class="text-primary fw-bold">Start Your Career Journey Today</h3>
  <p class="text-muted">Join thousands of students building their future with Amupro.</p>
  <a href="/listings" class="btn btn-primary">Explore Opportunities</a>
</div>

<!-- FOOTER -->
<footer class="pt-4 pb-3 mt-4">
  <div class="container text-center">
    <p class="small text-muted mb-1">© 2026 Amupro Pvt. Ltd.</p>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
