<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Amupro - About</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

<style>

body {
  font-family: 'Poppins', sans-serif;
  background: #f5f7fb;
}

/* ================= NAVBAR ================= */

.navbar {
  background: #ffffff;
  border-bottom: 1px solid #eee;
}

.navbar-brand {
  font-weight: 700;
  color: #0d6efd !important;
}

.navbar-toggler {
  border: none;
}

.navbar-toggler:focus {
  box-shadow: none;
}

/* Mobile collapse clean card */
@media(max-width:768px){
  .navbar-collapse{
    background:#ffffff;
    padding:20px;
    border-radius:15px;
    margin-top:10px;
    box-shadow:0 15px 40px rgba(0,0,0,0.08);
  }
}

/* ================= HERO ================= */

.hero-section {
  padding: 50px 20px 30px;
  text-align: center;
}

.hero-section h1 {
  font-weight: 700;
  font-size: 22px;
  line-height: 1.4;
  color: #0d6efd;
}

.hero-section p {
  font-size: 14px;
  color: #666;
  margin-top: 15px;
}

/* ================= CARDS ================= */

.custom-card {
  background: #ffffff;
  border-radius: 18px;
  padding: 20px;
  box-shadow: 0 8px 25px rgba(0,0,0,0.05);
}

.custom-card h4 {
  font-size: 16px;
  font-weight: 600;
}

.feature-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.feature-list li {
  padding: 8px 0;
  font-size: 14px;
  border-bottom: 1px solid #f0f0f0;
}

/* ================= FEATURE BOX ================= */

.feature-box {
  background: #ffffff;
  border-radius: 20px;
  padding: 20px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  transition: 0.3s;
  height: 100%;
}

.feature-box:hover {
  transform: translateY(-5px);
}

.feature-box h5 {
  font-size: 15px;
  font-weight: 600;
}

.feature-box p {
  font-size: 13px;
  color: #666;
}

/* ================= CTA ================= */

.cta-section {
  text-align: center;
  padding: 40px 20px;
}

.cta-section h3 {
  font-size: 18px;
  font-weight: 600;
  color: #0d6efd;
}

.cta-section p {
  font-size: 14px;
  color: #666;
}

.cta-section .btn {
  width: 100%;
  border-radius: 30px;
  padding: 12px;
  font-weight: 600;
}

/* ================= FOOTER ================= */

footer {
  background: #ffffff;
  font-size: 14px;
}

footer a {
  text-decoration: none;
  color: #555;
}

footer a:hover {
  color: #0d6efd;
}

</style>
</head>

<body>

<!-- ================= NAVBAR ================= -->
<nav class="navbar navbar-expand-lg sticky-top shadow-sm">
  <div class="container">

    <a class="navbar-brand d-flex align-items-center" href="/">
      <i class="fa-solid fa-handshake-angle me-2 text-primary"></i>
      Amupro
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse justify-content-end" id="mainNav">
      <ul class="navbar-nav">
        <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
        <li class="nav-item"><a class="nav-link active" href="/about">About</a></li>
        <li class="nav-item"><a class="nav-link" href="/contact">Contact</a></li>
      </ul>
    </div>

  </div>
</nav>


<!-- ================= HERO ================= -->
<div class="hero-section">
  <h1>Empowering Campus Youth for Better Career Opportunities</h1>
  <p>
    Many students struggle to find the right path due to lack of guidance,
    exposure and connections. Amupro helps students move confidently toward success.
  </p>
</div>


<div class="container">

  <!-- Challenges + Help -->
  <div class="row g-3 mb-4">

    <div class="col-12 col-md-6">
      <div class="custom-card">
        <h4 class="text-danger mb-3">Challenges Students Face</h4>
        <ul class="feature-list">
          <li> Lack of industry exposure</li>
          <li> No proper mentorship</li>
          <li> Difficulty getting referrals</li>
          <li> Interview preparation confusion</li>
          <li> Limited global access</li>
        </ul>
      </div>
    </div>

    <div class="col-12 col-md-6">
      <div class="custom-card">
        <h4 class="text-success mb-3">How Amupro Helps</h4>
        <ul class="feature-list">
          <li> Verified Job & Internship Opportunities</li>
          <li> Alumni Referral Support</li>
          <li> One-to-One Career Guidance</li>
          <li> Interview Preparation Guides</li>
          <li> Personal Mentorship</li>
        </ul>
      </div>
    </div>

  </div>

  <!-- Feature Grid -->
  <div class="row g-3 mb-4">

    <div class="col-12 col-md-4">
      <div class="feature-box">
        <h5>🎓 Alumni Referral</h5>
        <p>Connect with alumni and increase your chances of selection.</p>
      </div>
    </div>

    <div class="col-12 col-md-4">
      <div class="feature-box">
        <h5>💬 Career Guidance</h5>
        <p>Talk directly with experienced mentors and seniors.</p>
      </div>
    </div>

    <div class="col-12 col-md-4">
      <div class="feature-box">
        <h5>📘 Interview Guide</h5>
        <p>Curated interview notes and preparation material.</p>
      </div>
    </div>

  </div>

</div>

<!-- CTA -->
<div class="cta-section">
  <h3>Start Your Career Journey Today</h3>
  <p>Join thousands of students building their future with Amupro.</p>
  <a href="/listings" class="btn btn-primary">Explore Opportunities</a>
</div>


<!-- ================= FOOTER ================= -->
<footer class="pt-4 pb-3 mt-4">
  <div class="container text-center">
    <p class="small text-muted mb-1">© 2026 Amupro Pvt. Ltd.</p>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>