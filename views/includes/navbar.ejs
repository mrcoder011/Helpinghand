<!-- ================= GOOGLE FONT ================= -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

<!-- FONT AWESOME -->
<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

<style>

body{
font-family:'Poppins',sans-serif;
margin:0;
padding:0;
background:#f5f7fb;
}


/* ================= NAVBAR ================= */

.navbar{
background:#ffffff;
z-index:1050;
}

.nav-hover{
transition:0.3s;
border-radius:8px;
}

.nav-hover:hover{
background:rgba(13,110,253,0.08);
}

.navbar-toggler{
border-radius:10px;
padding:6px 10px;
background:#f8f9fa;
border:none;
}

.navbar-toggler:focus{
box-shadow:none;
}


/* MOBILE NAVBAR */

@media(max-width:767px){

.navbar-collapse{
background:#ffffff;
padding:20px;
margin-top:12px;
border-radius:15px;
box-shadow:0 20px 40px rgba(0,0,0,0.15);
animation:dropdownFade 0.3s ease;
}

.navbar-nav{
gap:15px !important;
}

.navbar-nav .nav-item{
width:100%;
}

.navbar-nav .nav-link{
padding:10px 15px;
border-radius:8px;
}

}

@keyframes dropdownFade{
from{
opacity:0;
transform:translateY(-10px);
}
to{
opacity:1;
transform:translateY(0);
}
}



/* ================= HERO ================= */

.hero{
position:relative;
padding:150px 0;
color:#fff;

background:linear-gradient(-45deg,#0d6efd,#6610f2,#0dcaf0,#20c997);
background-size:400% 400%;
animation:gradientMove 12s ease infinite;
}

@keyframes gradientMove{
0%{background-position:0% 50%;}
50%{background-position:100% 50%;}
100%{background-position:0% 50%;}
}


/* HERO OVERLAY */

.hero-overlay{

background:rgba(0,0,0,0.55);
padding:60px;
border-radius:20px;

backdrop-filter:blur(12px);

box-shadow:0 20px 60px rgba(0,0,0,0.35);

}


/* HERO TEXT */

.hero h1{
font-weight:700;
}

.hero p{
opacity:0.9;
}


/* BUTTONS */

.btn-premium{

background:#ffffff;
color:#0d6efd;
font-weight:600;

border-radius:40px;
padding:12px 30px;

transition:0.3s;
border:none;

}

.btn-premium:hover{

transform:translateY(-3px);

box-shadow:0 12px 25px rgba(0,0,0,0.3);

}

.btn-outline-premium{

border:2px solid #fff;
color:#fff;

border-radius:40px;
padding:12px 30px;

font-weight:600;

transition:0.3s;

}

.btn-outline-premium:hover{

background:#fff;
color:#0d6efd;

transform:translateY(-3px);

}



/* ================= SCROLL INDICATOR ================= */

.scroll-indicator{

font-size:14px;
opacity:0.9;

}

.mouse{

width:25px;
height:40px;

border:2px solid #fff;

border-radius:20px;

margin:10px auto;

position:relative;

}

.wheel{

width:4px;
height:8px;

background:#fff;

border-radius:4px;

position:absolute;

top:6px;
left:50%;

transform:translateX(-50%);

animation:scroll 1.5s infinite;

}

@keyframes scroll{

0%{opacity:0; top:6px;}

50%{opacity:1;}

100%{opacity:0; top:20px;}

}



/* MOBILE HERO */

@media(max-width:768px){

.hero{
padding:100px 0;
}

.hero-overlay{
padding:30px;
}

.hero h1{
font-size:32px;
}

}

</style>



<!-- ================= NAVBAR ================= -->

<nav class="navbar navbar-expand-md shadow-sm sticky-top border-bottom py-3">

<div class="container d-flex align-items-center">


<!-- BRAND -->

