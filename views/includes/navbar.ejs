<!-- ================= GOOGLE FONT ================= -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

<style>
body {
  font-family: 'Poppins', sans-serif;
}

/* ================= NAVBAR ================= */
.navbar {
  z-index: 1050;
  background: #ffffff;
}

.nav-hover:hover {
  background-color: rgba(13,110,253,0.1);
  transition: 0.3s ease;
}

/* ================= HERO ================= */

.hero {
  position: relative;
  padding: 150px 0;
  color: #fff;
  background: linear-gradient(-45deg, #0d6efd, #6610f2, #20c997, #0dcaf0);
  background-size: 400% 400%;
  animation: gradientMove 12s ease infinite;
}

@keyframes gradientMove {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.hero-overlay {
  background: rgba(0,0,0,0.55);
  padding: 60px;
  border-radius: 20px;
  backdrop-filter: blur(10px);
  box-shadow: 0 20px 60px rgba(0,0,0,0.3);
}

/* Buttons */
.btn-premium {
  background: #ffffff;
  color: #0d6efd;
  font-weight: 600;
  border-radius: 40px;
  padding: 12px 30px;
  transition: 0.3s;
}

.btn-premium:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.3);
}

.btn-outline-premium {
  border: 2px solid #fff;
  color: #fff;
  border-radius: 40px;
  padding: 12px 30px;
  font-weight: 600;
  transition: 0.3s;
}

.btn-outline-premium:hover {
  background: #fff;
  color: #0d6efd;
  transform: translateY(-3px);
}

/* Mobile Fix */
@media (max-width: 768px) {
  .hero-overlay {
    padding: 30px;
  }
}
</style>

<!-- ================= NAVBAR ================= -->
<nav class="navbar navbar-expand-md shadow-sm sticky-top border-bottom py-3">
  <div class="container">

    <a class="navbar-brand fw-bold text-primary d-flex align-items-center" href="/">
      <i class="fa-solid fa-handshake-angle me-2 fs-4"></i>
      <span class="fs-5">Amupro</span>
    </a>

    <button class="navbar-toggler border-0" type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
      <ul class="navbar-nav ms-auto gap-md-3 align-items-md-center">

        <li class="nav-item">
          <a class="nav-link fw-semibold nav-hover active" href="/">Home</a>
        </li>

        <li class="nav-item">
          <a class="nav-link fw-semibold nav-hover" href="/about">About</a>
        </li>

        <li class="nav-item">
          <a class="nav-link fw-semibold nav-hover" href="/contact">Contact us!</a>
        </li>

        <li class="nav-item position-relative">
          <a class="nav-link" href="#">
            <i class="fa-solid fa-bell fs-5"></i>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
              100+
            </span>
          </a>
        </li>

      </ul>
    </div>

  </div>
</nav>

<!-- ================= HERO ================= -->
<section class="hero text-center">
  <div class="container">
    <div class="hero-overlay">

      <h1 class="display-4 fw-bold mb-4">
        Find Your Next Opportunity
      </h1>

      <p class="lead mb-5">
        Discover internships, competitions, mentorships and more to boost your career and skills.
      </p>

      <div class="d-flex justify-content-center gap-4 flex-wrap">
        <a href="/listings" class="btn btn-premium">
          Browse Opportunities
        </a>
        <a href="/listings/new" class="btn btn-outline-premium">
          Post Opportunity
        </a>
      </div>

    </div>
  </div>
</section>