<!-- ================= GOOGLE FONT ================= -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

<style>
body {
  font-family: 'Poppins', sans-serif;
  margin: 0;
  padding: 0;
}

/* ================= NAVBAR ================= */

.navbar {
  z-index: 1050;
  background: #ffffff;
}

.nav-hover:hover {
  background-color: rgba(13,110,253,0.08);
  transition: 0.3s ease;
  border-radius: 8px;
}

.navbar-toggler {
  border-radius: 10px;
  padding: 6px 10px;
  background: #f8f9fa;
  border: none;
}

.navbar-toggler:focus {
  box-shadow: none;
}

/* MOBILE DROPDOWN FIX */
@media (max-width: 767px) {

  .navbar-collapse {
    background: #ffffff;
    padding: 20px;
    margin-top: 12px;
    border-radius: 15px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.15);
    animation: dropdownFade 0.3s ease;
  }

  .navbar-nav {
    gap: 15px !important;
  }

  .navbar-nav .nav-item {
    width: 100%;
  }

  .navbar-nav .nav-link {
    padding: 10px 15px;
    border-radius: 8px;
  }

}

@keyframes dropdownFade {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ================= HERO ================= */

.hero {
  position: relative;
  padding: 140px 0;
  color: #fff;
  background: linear-gradient(-45deg, #0d6efd, #6610f2, #0dcaf0, #20c997);
  background-size: 400% 400%;
  animation: gradientMove 12s ease infinite;
}

@keyframes gradientMove {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.hero-overlay {
  background: rgba(0,0,0,0.55);
  padding: 60px;
  border-radius: 20px;
  backdrop-filter: blur(10px);
  box-shadow: 0 20px 60px rgba(0,0,0,0.3);
}

/* Buttons */

.btn-premium {
  background: #ffffff;
  color: #0d6efd;
  font-weight: 600;
  border-radius: 40px;
  padding: 12px 30px;
  transition: 0.3s;
  border: none;
}

.btn-premium:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.3);
}

.btn-outline-premium {
  border: 2px solid #fff;
  color: #fff;
  border-radius: 40px;
  padding: 12px 30px;
  font-weight: 600;
  transition: 0.3s;
}

.btn-outline-premium:hover {
  background: #fff;
  color: #0d6efd;
  transform: translateY(-3px);
}

@media (max-width: 768px) {
  .hero-overlay {
    padding: 30px;
  }
}
</style>


<!-- ================= NAVBAR ================= -->
