<span class="fs-5">Amupro</span>

</div>

<small class="text-muted" style="font-size:11px;">
Empowering Students with Real Opportunities
</small>

</a>



<!-- TOGGLE -->

<button class="navbar-toggler"

type="button"

data-bs-toggle="collapse"

data-bs-target="#navbarNav">

<span class="navbar-toggler-icon"></span>

</button>



<!-- NAV LINKS -->

<div class="collapse navbar-collapse justify-content-end mt-3 mt-md-0" id="navbarNav">

<ul class="navbar-nav ms-auto gap-md-3 align-items-md-center">

<li class="nav-item">

<a class="nav-link fw-semibold nav-hover active" href="/">
Home
</a>

</li>

<li class="nav-item">

<a class="nav-link fw-semibold nav-hover" href="/about">
About
</a>

</li>

<li class="nav-item">

