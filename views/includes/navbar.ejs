  </div>

  <small class="text-muted" style="font-size:11px;">
    Empowering Students with Real Opportunities
  </small>

</a>
    <button class="navbar-toggler" type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
      <ul class="navbar-nav ms-auto gap-md-3 align-items-md-center">

        <li class="nav-item">
          <a class="nav-link fw-semibold nav-hover active" href="/">Home</a>
        </li>

        <li class="nav-item">
          <a class="nav-link fw-semibold nav-hover" href="/about">About</a>
        </li>

        <li class="nav-item">
          <a class="nav-link fw-semibold nav-hover" href="/contact">Contact us!</a>
        </li>

        <li class="nav-item position-relative">
          <a class="nav-link" href="#">
            <i class="fa-solid fa-bell fs-5"></i>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
              99+
            </span>
          </a>
        </li>

      </ul>
    </div>

  </div>
</nav>


