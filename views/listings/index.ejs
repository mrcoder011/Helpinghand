<style>


/* SECTION */

.opportunity-section{
background:#f8f9fa;
padding-top:80px;
padding-bottom:80px;
}



/* HEADING */

.typing-title{
font-size:42px;
background:linear-gradient(90deg,#0d6efd,#3a86ff);
-webkit-background-clip:text;
-webkit-text-fill-color:transparent;
display:inline-block;
overflow:hidden;
white-space:nowrap;
border-right:3px solid #0d6efd;
animation:typing 3s steps(30,end) forwards,blink .8s infinite;
}



/* SUBTITLE */

.subtitle{
max-width:620px;
margin:auto;
font-size:16px;
color:#6c757d;
}



/* IMAGE WRAPPER */

.img-wrapper{
overflow:hidden;
border-radius:14px 14px 0 0;
position:relative;
}



/* IMAGE */

.opportunity-img{
height:210px;
object-fit:cover;
transition:transform .5s ease;
}



/* IMAGE ZOOM */

.opportunity-card:hover .opportunity-img{
transform:scale(1.08);
}



/* CARD */

.opportunity-card{
border:none;
border-radius:14px;
box-shadow:0 10px 35px rgba(0,0,0,0.06);
transition:all .35s ease;
background:#fff;
}



/* CARD HOVER */

.opportunity-card:hover{
transform:translateY(-10px);
box-shadow:0 35px 65px rgba(0,0,0,0.15);
}



/* BADGE */

.badge-top{
position:absolute;
top:14px;
left:14px;
background:#ff4d4f;
color:white;
font-size:11px;
padding:6px 10px;
border-radius:20px;
}



/* BUTTON */

.btn-main{
background:#0d6efd;
color:white;
font-size:14px;
border-radius:8px;
padding:8px 16px;
transition:.3s;
}

.btn-main:hover{
background:#0b5ed7;
color:white;
transform:scale(1.05);
}



/* ANIMATION */

@keyframes typing{
from{width:0}
to{width:100%}
}

@keyframes blink{
50%{border-color:transparent}
}



/* MOBILE */

@media (max-width:768px){

.typing-title{
font-size:28px;
white-space:normal;
border-right:none;
animation:none;
}

.subtitle{
font-size:14px;
}

.opportunity-img{
height:170px;
}

}

</style>

` }) %>