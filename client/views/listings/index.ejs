<%- include("../layouts/boilerplate") %>

<div class="container py-5">
  <h1 class="mb-5 text-center fw-bold text-primary">
    Explore Career Opportunities
  </h1>

  <div class="row g-4">

    <div class="col-md-4">
      <div class="card shadow border-0 h-100 p-3">
        <h4>Job Openings</h4>
        <p class="text-muted">Discover a full-time career options in companies across India.</p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow border-0 h-100 p-3">
        <h4>Internships / Training</h4>
        <p class="text-muted">Apply for industry-oriented training and internships.</p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow border-0 h-100 p-3">
        <h4>🎓 Alumni Referral</h4>
        <p class="text-muted">Get referrals from alumni working in top companies.</p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow border-0 h-100 p-3">
        <h4>💬 1-to-1 Talk with TPO / Seniors</h4>
        <p class="text-muted">Personal career guidance sessions.</p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow border-0 h-100 p-3">
        <h4>📘 Interview Guide & Cheat Notes</h4>
        <p class="text-muted">Prepare with curated interview material.</p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow border-0 h-100 p-3">
        <h4>👨‍🏫 Weekly / Monthly Mentor</h4>
        <p class="text-muted">Get a personal mentor to guide your progress.</p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow border-0 h-100 p-3">
        <h4>🇮🇳 Jobs in Your Country</h4>
        <p class="text-muted">Explore verified jobs in your country.</p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow border-0 h-100 p-3">
        <h4>🌍 Jobs Abroad</h4>
        <p class="text-muted">Discover international career opportunities.</p>
      </div>
    </div>

  </div>
</div>
